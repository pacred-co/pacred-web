{
  "name": "pacred-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test:customer-address-continuity": "tsx lib/admin/customer-address-book.test.ts && tsx lib/admin/customer-address-continuity-contract.test.ts",
    "test": "node scripts/run-unit-tests.mjs --with-integration && tsx lib/forwarder/yiwu-cabinet-name.test.ts && tsx lib/forwarder/container-eta-estimate.test.ts && tsx lib/admin/hs-search.test.ts",
    "test:unit": "node scripts/run-unit-tests.mjs && tsx lib/forwarder/yiwu-cabinet-name.test.ts && tsx lib/forwarder/container-eta-estimate.test.ts && tsx lib/admin/hs-search.test.ts",
    "test:shop-order-spine": "tsx lib/admin/shop-order-status-rule.test.ts && tsx lib/admin/shop-order-status-migration-contract.test.ts && tsx lib/admin/shop-forwarder-handoff.test.ts && tsx lib/service-order/payment-amount.test.ts && tsx actions/admin/service-orders-shop-workflow.test.ts",
    "test:wallet-slip-group": "tsx lib/admin/wallet-slip-group.test.ts && tsx lib/admin/topup-slip-dedup.test.ts && tsx lib/admin/duplicate-slip-check.test.ts",
    "audit:md": "node scripts/md-link-audit.mjs",
    "audit:env": "node scripts/env-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:i18n-keys": "node scripts/i18n-key-audit.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:all": "pnpm audit:md && pnpm audit:env && pnpm audit:i18n && pnpm audit:i18n-keys && pnpm audit:currency",
    "check:connections": "node scripts/check-connections.mjs",
    "typecheck": "node scripts/tsc-check.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm audit:all",
    "audit:currency": "node scripts/currency-symbol-audit.mjs"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@line/liff": "^2.29.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bwip-js": "^4.10.2",
    "google-auth-library": "^10.6.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.11.1",
    "papaparse": "^5.5.3",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "sanitize-html": "^2.17.6",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "ws": "^8.21.0"
  }
}
